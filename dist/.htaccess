# The folder URL (/phan-tich-du-lieu-voi-r/) must open index.html. On 20/11/2026, once this folder had held an
# .htaccess, the hosting (LiteSpeed) sent that URL to the main site's PHP instead (its "404" page), and kept doing
# so after the file was removed. With its own rewrite rules this folder no longer takes the main site's rules,
# and the folder URL is mapped to the page here.
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^$ index.html [L]

# The hosting sends the page with no Cache-Control, so browsers kept an old copy for a while after a deploy.
# The page is now checked on every visit (a short 304 when it has not changed). Its script and stylesheet carry
# ?v= in their links and keep the hosting's week-long cache.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
